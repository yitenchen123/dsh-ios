#!/bin/sh
# 安装后处理：rootless deb，所有路径带 /var/jb 前缀。
#
# 硬约束：绝不写 $DSH_HOME（/var/jb/var/mobile/.dsh）。用户的对话、工作区、
# 插件、cordis.patch.yml、profiles/* 一个字节都不动、不改属主、不改权限。
# 旧版在这里 mkdir/chown -R/chmod -R/chmod 777、跑 fix-session 迁移、删
# .dsh-tier、清 cordis.patch.yml 软链，全部已移除。
set -e
JB=/var/jb
D="$JB/usr/lib/dsh"
NODE="$D/bin/node"

if [ ! -L "$JB" ]; then
    echo "dsh: 未检测到 rootless 越狱环境 (/var/jb)，跳过运行时配置。" >&2
    exit 0
fi

chmod 755 "$NODE" "$JB/usr/bin/dsh" "$JB/usr/bin/dsh-doctor" 2>/dev/null || true

# 重要：本包内置 node 来自上游 deb，二进制自身已带完整 JIT entitlements
# （allow-jit / allow-unsigned-executable-memory / dynamic-codesigning /
#  skip-library-validation / no-sandbox 等 9 项，直接签在 LC_CODE_SIGNATURE 里）。
# 绝不能用旧版那份只有 4 项的 ent.plist 无条件重签 —— 那会把 JIT 权限覆盖掉，
# 造成「node -v 正常、一执行 JS 就 SIGBUS」。策略：
#   1) 二进制自带 dynamic-codesigning -> 原封不动保留原签名，只 trust-cache；
#   2) 确实缺 entitlement            -> 用补全的 ent.plist（原 9 项的超集）补签。
HAS_JIT=0
if command -v ldid >/dev/null 2>&1; then
    if ldid -e "$NODE" 2>/dev/null | grep -q dynamic-codesigning; then HAS_JIT=1; fi
elif strings "$NODE" 2>/dev/null | grep -q dynamic-codesigning; then
    HAS_JIT=1
fi
if [ "$HAS_JIT" -eq 1 ]; then
    echo "dsh: node 自带完整 JIT entitlement，保留原签名。"
elif command -v ldid >/dev/null 2>&1; then
    echo "dsh: node 缺 JIT entitlement，用 ent.plist 补签。"
    ldid -S"$D/ent.plist" "$NODE" 2>/dev/null || ldid -S "$NODE" 2>/dev/null || true
fi

# 尽力而为：把 node 注入 trustcache。失败不影响安装。
if command -v trustcache >/dev/null 2>&1; then
    trustcache inject "$NODE" 2>/dev/null || true
fi

# 日志放 jbroot 系统区，绝不 mkdir/chown $DSH_HOME/logs。
mkdir -p "$JB/var/log/dsh-app" 2>/dev/null || true

# PATH 兜底：少数终端只有 /var/jb/bin，补一个软链保证「敲 dsh 一定能找到」。
if [ ! -e "$JB/bin/dsh" ]; then
    mkdir -p "$JB/bin" 2>/dev/null || true
    ln -sf "$JB/usr/bin/dsh" "$JB/bin/dsh" 2>/dev/null || true
fi

# --- single-package extras：APP 签名 + 全屏 Web Clip + uicache + 保活 ---
# 这个文件必须由 build-one-package.sh 真正打进包里。旧版构建脚本漏了它，
# 于是 `[ -x "$EX" ]` 恒为假、全屏 Web Clip 从来没装进设备 —— 这正是
# 「依旧不是全屏」的直接原因。缺文件时显式报错，不再静默跳过。
EX="$D/dsh-extras-postinst.sh"
if [ -x "$EX" ]; then
    "$EX" || echo "dsh: [warn] extras 有失败项（见上方输出），可手动重跑 $EX" >&2
else
    echo "dsh: [ERROR] 缺 $EX，全屏入口 / APP 未注册；此 deb 构建不完整！" >&2
fi

echo "DSH 安装完成。点桌面「DeepSeek Harness」全屏图标即用；终端输入 dsh 亦可。"
echo "  工作区 / 会话 / 插件全部保留，本包没有写入 \$DSH_HOME。"
exit 0
