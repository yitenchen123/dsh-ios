<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DSH_BRIDGE_PORT</key>
		<string>8091</string>
		<key>DSH_HOME</key>
		<string>/var/jb/var/mobile/.dsh</string>
		<key>DSH_IOS_MCP_URL</key>
		<string>http://127.0.0.1:8090/mcp</string>
		<key>HOME</key>
		<string>/var/mobile</string>
		<key>NODE_PATH</key>
		<string>/var/jb/usr/lib/dsh/node_modules</string>
		<key>PATH</key>
		<string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>10</integer>
	<key>GroupName</key>
	<string>mobile</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>dev.airdevs.dsh.phone-bridge</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/bin/sh</string>
		<string>/var/jb/usr/bin/dsh-phone-bridge-daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/dsh-app/phone-bridge.err.log</string>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/dsh-app/phone-bridge.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>mobile</string>
	<key>WorkingDirectory</key>
	<string>/var/mobile</string>
</dict>
</plist>
