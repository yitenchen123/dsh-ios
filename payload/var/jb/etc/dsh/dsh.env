# dsh 运行时配置（由 /var/jb/usr/bin/dsh 读取）
# 改完直接生效，不需要重启任何服务。

# 用 := 而非 = ：命令行 / 环境里已经 export 的值优先，这里只作默认值。
# 无参数敲 dsh 时启动哪个 profile。可选：web / headless / acp / sdk / sdk-minimal
: "${DSH_DEFAULT_PROFILE:=web}"

# web profile 监听端口（3080 被占用就改这里，或临时 DSH_WEB_PORT=3099 dsh）
: "${DSH_WEB_PORT:=3080}"

# 内置 node v22.12.0（iPhone X/A11 真机验证的标准 JIT 构建）。
# 如需改用设备上的其它 node，取消下行注释并指向绝对路径。
# DSH_NODE=/var/jb/usr/bin/node

# iPhone X / A11 / 3GB：限制 V8 堆，避免 jetsam 杀进程。
# 4GB+ 设备可放宽到 640。不要在跑 MC 的同时跑 dsh。
: "${NODE_OPTIONS:=--max-old-space-size=384}"

# --- +ios3 启动档位（一般不用改，dsh 会自动探测并缓存） ---
# dsh 启动前跑 smoke.js 真触发 WASM 编译，逐档选第一个不 SIGBUS 的组合，
# 结果写入 $DSH_HOME/.dsh-tier，之后零开销。想强制指定就取消注释：
#   native    无额外参数，性能最好（设备本来正常时）
#   single    --single-threaded，编译收回主线程，保留全部功能
#   balanced  + 禁并发编译 / WASM 编译单线程
#   safe      + 禁并发 GC / 限优化层
#   nowasm    --jitless + fetch-shim，完全不生成可执行代码，零 JIT 兜底
# DSH_TIER=nowasm
#
# 设成 1 可强制每次启动重新探测（或跑 dsh-doctor，它默认强制重探）。
# DSH_REPROBE=1

# 会话与配置目录（默认 /var/jb/var/mobile/.dsh，保留在卸载之后）
# DSH_HOME=/var/jb/var/mobile/.dsh

# --- +ios13 起：插件安装（本包不预装插件；+ios14 pnpm 绝对值连 + 零 JIT） ---
# dsh 官方命令，包内已带纯 JS pnpm：
#   dsh plugin --profile web add <包名>
#   dsh-compat                 # 装完 @xmanrui/dsh-im 后补 A11 零 JIT 补丁
# store/cache 自动落到 $DSH_HOME，不会写 root 属主目录。
