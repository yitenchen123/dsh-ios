<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- rootless 越狱 app 必需：让 SpringBoard 以「平台应用」启动 /var/jb 下的 .app。
	     这是 ldid 伪签（ad-hoc），不需要 Apple 开发者证书。 -->
	<key>platform-application</key>
	<true/>
	<!-- 不进 App container：DSH_HOME 在 /var/jb 下，app 还要读 daemon 日志拿 token。
	     SFSafariViewController 的页面跑在系统 SafariViewService 里，不依赖本进程
	     的 WebKit 容器，所以 no-container 不会影响页面加载。 -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container</key>
	<false/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
		<string>/private/preboot/</string>
		<string>/var/</string>
		<string>/private/var/</string>
	</array>
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
